venv/           # Local Python virtual environment — never commit (gigabytes, machine-specific)
output/         # Trained PyTorch model weights — regenerated by train.py, too large for git
onnx/           # Exported ONNX model files — regenerated by export_onnx.py
dataset.json    # Generated training data — regenerated by generate_dataset.py
__pycache__/
*.pyc
.pytest_cache/
